{
  "name": "timeline-workspace",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "pnpm --filter @timeline/web dev",
    "build": "pnpm --filter @timeline/web build",
    "start": "pnpm --filter @timeline/web start",
    "typecheck": "pnpm --filter @timeline/web typecheck",
    "lint": "pnpm --filter @timeline/web lint",
    "test": "pnpm --filter @timeline/web test",
    "test:unit": "pnpm --filter @timeline/web test:unit",
    "test:db": "pnpm --filter @timeline/web test:db",
    "test:browser": "pnpm --filter @timeline/web test:browser",
    "test:e2e": "pnpm --filter @timeline/web test:e2e",
    "test:built": "pnpm --filter @timeline/web test:built",
    "test:quality": "pnpm --filter @timeline/web test:quality",
    "test:local": "pnpm --filter @timeline/web test:local",
    "test:integration": "pnpm --filter @timeline/web test:integration",
    "test:deployed:public": "pnpm --filter @timeline/web test:deployed:public",
    "test:deployed:read": "pnpm --filter @timeline/web test:deployed:read"
  }
}
